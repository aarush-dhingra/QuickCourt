NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/quickcourt

JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

EMAIL_FROM=no-reply@quickcourt.local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

DEV_OTP_ENABLED=true
DEV_OTP=123456

CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Facility Owner Module — Photo Uploads (multer)
# ---------------------------------------------------------------------------
# Maximum number of photos per facility (default: 10)
MAX_PHOTOS_PER_FACILITY=10
# Maximum file size per photo in megabytes (default: 5)
MAX_FILE_SIZE_MB=5
